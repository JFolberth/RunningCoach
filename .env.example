# Fitbit API Credentials
# Register your app at https://dev.fitbit.com/apps
# Use "Personal" application type for your own data
FITBIT_CLIENT_ID=your_client_id_here
FITBIT_CLIENT_SECRET=your_client_secret_here

# OAuth callback (default works for local development)
FITBIT_REDIRECT_URI=http://localhost:8080/callback

# Race goal configuration:
# Run `python main.py setup` to configure your race goal interactively.
# This creates race_config.json (user-specific, not committed to git).
